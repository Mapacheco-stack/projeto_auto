generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model causas_possiveis {
  id               Int                @id @default(autoincrement())
  nome             String             @unique(map: "uq_causas_nome") @db.VarChar(180)
  resumo           String
  recomendacao     String
  nivel_gravidade  Int                @default(1) @db.SmallInt
  ativo            Boolean            @default(true)
  problemas_causas problemas_causas[]
}

model fabricantes {
  id               Int                @id @default(autoincrement())
  nome             String             @unique(map: "uq_fabricantes_nome") @db.VarChar(100)
  ativo            Boolean            @default(true)
  modelos_veiculos modelos_veiculos[]
}

model mensagens_isencao {
  id     Int     @id @default(autoincrement())
  titulo String  @db.VarChar(150)
  texto  String
  ativo  Boolean @default(true)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model modelos_veiculos {
  id            Int         @id @default(autoincrement())
  fabricante_id Int
  nome          String      @db.VarChar(100)
  ano_inicio    Int?        @db.SmallInt
  ano_fim       Int?        @db.SmallInt
  ativo         Boolean     @default(true)
  fabricantes   fabricantes @relation(fields: [fabricante_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_modelos_fabricantes")

  @@unique([fabricante_id, nome], map: "uq_modelos_fabricante_nome")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model problemas {
  id               Int                @id @default(autoincrement())
  nome             String             @unique(map: "uq_problemas_nome") @db.VarChar(150)
  descricao        String?
  nivel_urgencia   Int                @default(1) @db.SmallInt
  ativo            Boolean            @default(true)
  problemas_causas problemas_causas[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model problemas_causas {
  problema_id       Int
  causa_possivel_id Int
  ordem_exibicao    Int              @default(0)
  causas_possiveis  causas_possiveis @relation(fields: [causa_possivel_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_problemas_causas_causas")
  problemas         problemas        @relation(fields: [problema_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_problemas_causas_problemas")

  @@id([problema_id, causa_possivel_id], map: "pk_problemas_causas")
}

model admins {
  senha String  @id @db.VarChar
  nome  String? @db.VarChar(15)
}
